# See README.md's "Setup" section for the full walkthrough — this file
# just lists every variable the app reads, grouped by what they're for.
# Only DATABASE_URL is required to get `npm run dev` running at all;
# everything else unlocks one specific feature and is safe to leave
# blank until you're ready to set that feature up.

# --- Required to start the app -----------------------------------------

DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# --- Sign-in (GitHub + Google OAuth via Auth.js v5) ---------------------
# See README.md's "Setting up sign-in" section for how to generate these.

AUTH_SECRET=""
AUTH_GITHUB_ID=""
AUTH_GITHUB_SECRET=""
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# --- Scraping (Firecrawl) ------------------------------------------------

FIRECRAWL_API_KEY=""

# --- Chat (Gemini) --------------------------------------------------------

GEMINI_API_KEY=""

# --- Rate limiting (Upstash Redis) ----------------------------------------

UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# --- Error tracking (Sentry) -----------------------------------------------
# NEXT_PUBLIC_ prefix is correct for the DSN — it's a public destination
# identifier, not a secret. The other three are only needed for source-map
# upload during a real deploy; safe to leave blank locally.

NEXT_PUBLIC_SENTRY_DSN=""
SENTRY_ORG=""
SENTRY_PROJECT=""
SENTRY_AUTH_TOKEN=""

# --- Admin dashboard --------------------------------------------------------
# Whatever email you sign in with (GitHub/Google) — visiting /admin with
# that account shows usage stats; any other account gets a 403.

ADMIN_EMAIL=""

# --- Scheduled cache cleanup (Vercel Cron) -----------------------------------
# Any random string (e.g. `openssl rand -hex 32`). Set the same value in
# your Vercel project's env vars — Vercel Cron sends it automatically as
# `Authorization: Bearer $CRON_SECRET` when it calls
# GET /api/cron/purge-expired-sites on the schedule in vercel.json. Safe to
# leave blank locally; the route just returns 401 with nothing set, and
# nothing calls it in `npm run dev` anyway.

CRON_SECRET=""
